DATABASE_URL="file:./dev.db"
PORT=3000

# Cấu hình AI Summarize (OpenAI, Gemini, Anthropic)
# Cung cấp ít nhất 1 API key để kích hoạt tính năng tóm tắt thật
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Tùy chọn: Chọn nhà cung cấp (gemini | openai | anthropic)
# AI_PROVIDER=gemini

# Tùy chọn: Tên model tùy biến
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Tùy chọn: Timeout tính bằng mili-giây (mặc định 15000ms = 15s)
# AI_TIMEOUT_MS=15000

# Tùy chọn cho dev/test: Bật mô phỏng tóm tắt demo khi không có API key
# MOCK_AI=false
