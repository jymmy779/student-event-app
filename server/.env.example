DATABASE_URL="file:./dev.db"
PORT=3000

# ==============================================================================
# CẤU HÌNH AI DÀNH CHO TÓM TẮT GHI CHÚ SỰ KIỆN (MỐC 3 - KHA)
# ==============================================================================
# Bạn có thể cung cấp AI_API_KEY hoặc một trong các key cụ thể bên dưới:
# 1. Google Gemini (Khuyên dùng - miễn phí qua Google AI Studio: https://aistudio.google.com/app/apikey)
AI_API_KEY=
GEMINI_API_KEY=

# 2. OpenAI (Lấy từ: https://platform.openai.com/api-keys)
# OPENAI_API_KEY=

# 3. Anthropic Claude (Lấy từ: https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=

# Tùy chọn: Chọn nhà cung cấp cụ thể (gemini | openai | anthropic). Nếu để trống, server tự nhận diện theo tiền tố key.
# AI_PROVIDER=gemini

# Tùy chọn: Tên model tùy biến
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Tùy chọn: Timeout tính bằng mili-giây (mặc định 15000ms = 15 giây)
# AI_TIMEOUT_MS=15000

# Tùy chọn cho dev/test: Bật mô phỏng tóm tắt demo khi không có API key thật
# MOCK_AI=false

